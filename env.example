# Azure AD Configuration (for MSAL authentication)
AZURE_CLIENT_ID=your-client-id
AZURE_TENANT_ID=your-tenant-id
AZURE_REDIRECT_URI=http://localhost:8501

# AWS Configuration (for Bedrock)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# Note: CLIENT_SECRET is not needed for interactive authentication
# The application will handle token acquisition and refresh automatically